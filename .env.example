# Rain hackathon sandbox credentials (get yours at the workshop desk).
# Copy to .env and fill in. NEVER commit the real .env — it's gitignored.
RAIN_API_BASE=https://api-dev.raincards.xyz/v1
RAIN_API_KEY=your-team-api-key
RAIN_USER_ID=your-user-id
RAIN_TEAM_ID=your-team-id
RAIN_COLLATERAL_CONTRACT_ID=your-collateral-contract-id

# Monad mainnet (chain 143) — onchain purchase receipts (optional; app runs fine without it).
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143
MONAD_EXPLORER=https://monadscan.com
MONAD_PRIVATE_KEY=0x-a-throwaway-key-funded-via-faucet.monad.xyz
MONAD_LEDGER_ADDRESS=deployed-SpendLedger-address
